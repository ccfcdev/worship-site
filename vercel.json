{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(kb|k25-photos).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/apply",
      "destination": "/join",
      "permanent": true
    },
    {
      "source": "/audition",
      "destination": "/join",
      "permanent": true
    },
    {
      "source": "/sets",
      "destination": "/videos",
      "permanent": true
    },
    {
      "source": "/music",
      "destination": "/videos",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "https://ccfczambia.org/privacy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "https://ccfczambia.org/terms",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/join#faq",
      "permanent": true
    }
  ]
}